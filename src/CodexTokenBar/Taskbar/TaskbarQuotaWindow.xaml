<Window x:Class="CodexTokenBar.Taskbar.TaskbarQuotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64"
        Height="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseRightButtonDown="OnMouseRightButtonDown"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="HoverSurface" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="Surface" Style="{StaticResource HoverSurface}" CornerRadius="4">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="RingImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="None"
                   SnapsToDevicePixels="True"/>
            <TextBlock x:Name="RingText"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="Grayscale"/>
        </Grid>
    </Border>
</Window>
