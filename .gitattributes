# Auto detect text files and perform LF normalization
* text=auto

# Markdown, YAML, JSON, XML, C#, solution and project files -> LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.cs text eol=lf
*.sln text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# PowerShell scripts -> CRLF
*.ps1 text eol=crlf
